# Copy this to a file named ".env" at the PROJECT ROOT (F:\cheil-studio-lite\.env).
# The root .env is gitignored — this .example file is committed, so it must
# never contain real credentials.
#
# --- Gemini auth: choose ONE of the two modes below ---

# Mode 1: Vertex AI with a service account (for orgs that block API keys)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=F:/cheil-studio-lite/backend/service-account.json

# Mode 2: AI Studio API key (simpler; leave Mode 1 vars unset to use this)
# GEMINI_API_KEY=AIzaSy...

# --- Observability (optional) ---
# Traces, token usage, cost and feedback scores. If these are unset, tracing is
# a no-op and the app runs normally. Get keys from https://cloud.langfuse.com
# NOTE: prompts and completions contain campaign copy, so enabling this sends
# that content to Langfuse.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
